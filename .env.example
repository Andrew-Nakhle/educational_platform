APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite: create an empty database/database.sqlite file.
# DB_DATABASE defaults to database/database.sqlite when left unset.
# For MySQL, set DB_CONNECTION=mysql and uncomment the lines below.
DB_CONNECTION=sqlite
# DB_URL=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Disk for uploads (avatars, certificates, thumbnails, lesson videos/HLS).
# local_uploads = storage/app/private/uploads (local development)
# b2            = Backblaze B2 via the AWS_* settings below (production; the default when unset)
UPLOAD_DISK=local_uploads

# Lifetime in minutes of signed URLs for thumbnails, avatars and certificates.
# Leave empty to keep the built-in defaults (1000 for thumbnails, 30 for avatars/certificates).
# The lesson video link is always 30 minutes.
SIGNED_URL_MINUTES=

# Upload size limits in KB (validation). PHP's upload_max_filesize and
# post_max_size must be at least as large, or PHP drops the upload first.
# Course thumbnails (jpg, jpeg, png, webp): default 5120 (5 MB).
THUMBNAIL_MAX_KB=5120
# Lesson videos (mp4, mov, webm): default 2097152 (2 GB).
VIDEO_MAX_KB=2097152

# sync runs jobs (lesson video processing) inside the request; no worker needed.
# Use "database" and run `php artisan queue:work` for background processing.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Backblaze B2 (S3-compatible), used when UPLOAD_DISK=b2.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=https://s3.your-region.backblazeb2.com
# AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe (test keys for local development). The webhook secret comes from
# `stripe listen --forward-to localhost:8000/api/payments/stripe/webhook`.
STRIPE_SECRET=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Frontend base URL used for the Stripe Checkout success/cancel redirects.
FRONTEND_URL=http://localhost:5173

# ffmpeg/ffprobe binaries used to convert lesson videos to HLS.
# Use forward slashes: backslashes inside quotes are escape sequences in .env.
FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe

VITE_APP_NAME="${APP_NAME}"
